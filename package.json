{
  "name": "printworks",
  "version": "1.0.0",
  "description": "Local-first 3D print history, pricing, and catalog dashboard with multi-provider sync.",
  "main": "api.ts",
  "scripts": {
    "sync": "npx tsx sync-configured-providers.ts",
    "sync:bambu": "npx tsx dump-bambu-history.ts",
    "sync:moonraker": "npx tsx sync-moonraker-history.ts",
    "covers:repair": "npx tsx scripts/repair-covers.ts",
    "catalog": "npx tsx scan-catalog.ts",
    "normalize": "npx tsx normalize.ts",
    "baseline": "npx tsx scripts/baseline-report.ts",
    "api": "npx tsx api.ts",
    "dev": "concurrently --kill-others --names api,ui \"npm run dev:api\" \"npm run dev:ui\"",
    "dev:api": "npx tsx watch api.ts",
    "dev:full": "npm run dev",
    "build:ui": "vite build",
    "dev:ui": "vite",
    "build": "npm run build:ui && tsc -p tsconfig.build.json",
    "smoke": "npx tsx scripts/smoke-test.ts",
    "typecheck": "tsc -p tsconfig.backend.json --noEmit && tsc -p tsconfig.frontend.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.ts\" \"**/*.json\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.ts\" \"**/*.json\" --ignore-path .gitignore"
  },
  "keywords": [],
  "author": "Adam",
  "license": "ISC",
  "engines": {
    "node": ">=20.9.0"
  },
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^17.4.2",
    "hono": "^4.12.34",
    "htm": "^3.1.1",
    "preact": "^10.29.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.11.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@13.0.2": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.1": true
  }
}
